# data/*.csv IS needed at runtime now: POST /admin/bootstrap (see
# app/api/admin.py) reads them to seed the database over HTTPS, since a
# serverless deployment + managed Postgres has no shell to run
# scripts/load_data.py from directly. Kept in the bundle deliberately --
# do not re-add an exclusion for it.

.venv/
tests/
scripts/
alembic/
__pycache__/
.pytest_cache/
*.log
